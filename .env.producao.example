# Variaveis do docker-compose.prod.yml (NAO sao as do Laravel).
# Na VPS:  cp .env.producao.example .env.producao  e preencher.
# Este ficheiro nao deve ser versionado (RNF-13).

# Porta local onde o proxy do SGA escuta. So no loopback -- quem a expoe ao
# mundo e o Apache do host. Mudar se ja estiver ocupada por outro projecto.
PORTA_HTTP=8100

# Credenciais do Postgres do contentor. TEM de coincidir com as
# DB_* de backend/.env.producao.
DB_DATABASE=sga
DB_USERNAME=sga
DB_PASSWORD=TROCAR_POR_SEGREDO_FORTE
