# Copiar para .env antes do primeiro arranque:  cp .env.example .env
# O ficheiro .env NAO deve ser versionado (RNF-13)

APP_NAME="Sistema de Gestao Academica"
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Africa/Maputo
APP_LOCALE=pt
APP_URL=http://localhost:8000

PORTA_HTTP=8000
VITE_API_URL=http://localhost:8000/api/v1

DB_CONNECTION=pgsql
DB_DATABASE=sga
DB_USERNAME=sga
DB_PASSWORD=segredo_local

REDIS_HOST=cache
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# Expiracao do token de acesso, em minutos (RNF-11)
SANCTUM_EXPIRACAO=60

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="sga@escn.ac.mz"
