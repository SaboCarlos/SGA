@startuml casos-de-uso-administracao
skinparam backgroundColor White
skinparam shadowing false
skinparam ArrowColor #2C3E50
skinparam ActorBorderColor #2C3E50
skinparam UsecaseBorderColor #2C3E50
skinparam UsecaseBackgroundColor #F8FAFC
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
left to right direction
title SGA - Administracao, aproveitamento, pautas e relatorios

actor "Estudante" as EST
actor "Docente" as DOC
actor "Coordenador\nde Curso" as COORD
actor "Administrador" as ADM
actor "Servico de\nCalendario" as SYS <<system>>

rectangle "Administracao e Consultas" {
  usecase "UC01\nAutenticar-se" as UC01
  usecase "UC02\nGerir contas de\nutilizador" as UC02
  usecase "UC03\nAtribuir perfis" as UC03
  usecase "UC04\nRecuperar\npalavra-passe" as UC04
  usecase "UC05\nValidar permissoes" as UC05

  usecase "UC06\nGerir estudantes" as UC06
  usecase "UC07\nGerir docentes" as UC07
  usecase "UC08\nGerir cursos" as UC08
  usecase "UC09\nGerir disciplinas" as UC09
  usecase "UC10\nDefinir plano\ncurricular" as UC10
  usecase "UC11\nDefinir\npre-requisitos" as UC11
  usecase "UC12\nGerir ano lectivo" as UC12
  usecase "UC13\nCriar turmas" as UC13

  usecase "UC25\nConsultar\naproveitamento" as UC25
  usecase "UC26\nEmitir pauta" as UC26
  usecase "UC27\nHomologar pauta" as UC27
  usecase "UC28\nExportar em PDF" as UC28
  usecase "UC29\nGerar relatorios" as UC29
  usecase "UC30\nConsultar painel" as UC30
  usecase "UC31\nConsultar auditoria" as UC31
  usecase "UC34\nNotificar periodo\nde inscricoes" as UC34
}

EST --> UC01
EST --> UC04
EST --> UC25
EST --> UC30
DOC --> UC26
DOC --> UC30
COORD --> UC10
COORD --> UC11
COORD --> UC13
COORD --> UC25
COORD --> UC27
COORD --> UC29
ADM --> UC02
ADM --> UC03
ADM --> UC06
ADM --> UC07
ADM --> UC08
ADM --> UC09
ADM --> UC12
ADM --> UC29
ADM --> UC31
SYS --> UC34

UC01 ..> UC05 : <<include>>
UC10 ..> UC09 : <<include>>
UC13 ..> UC12 : <<include>>
UC26 ..> UC28 : <<extend>>
UC29 ..> UC28 : <<extend>>
UC25 ..> UC28 : <<extend>>
UC27 ..> UC26 : <<include>>
@enduml
