# Configuracao do Laravel em producao.
# Na VPS:  cp backend/.env.producao.example backend/.env.producao
# Gerar a chave:  make chave-producao
# Este ficheiro nao deve ser versionado (RNF-13).

APP_NAME="Sistema de Gestao Academica"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Maputo
APP_LOCALE=pt

# Dominio publico da API (o que o Apache serve). Usado para gerar URLs
# absolutos em e-mails e respostas.
APP_URL=https://api.SEU-DOMINIO.com

# stderr em vez de ficheiro: os logs passam a sair em "docker compose logs",
# em vez de encherem storage/logs dentro de um contentor efemero.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=sga
DB_USERNAME=sga
DB_PASSWORD=TROCAR_POR_SEGREDO_FORTE

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=cache
REDIS_PORT=6379

# Expiracao do token de acesso, em minutos (RNF-11)
SANCTUM_EXPIRACAO=60

# Origens autorizadas a chamar a API a partir do browser (CORS).
# Lista separada por virgulas. Em producao o frontend vive no Vercel, por
# isso tem de constar aqui -- caso contrario o browser bloqueia as chamadas.
CORS_ORIGINS=https://sga.vercel.app

# Deixar a "true" permite tambem os dominios de pre-visualizacao do Vercel
# (https://<qualquer-coisa>.vercel.app), uteis enquanto se testam branches.
# Passar a "false" quando o dominio final estiver fixado.
CORS_PERMITIR_PREVIEWS_VERCEL=true

# SMTP real. O mailpit so existe em desenvolvimento.
MAIL_MAILER=smtp
MAIL_HOST=smtp.exemplo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="sga@escn.ac.mz"
MAIL_FROM_NAME="${APP_NAME}"
